    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Card Astro + Elm</title>
  </head>
  <body class="p-4">
    <div id="elm-app"></div>

    <script src="/main.js" is:inline></script>

    <script>
      var app = Elm.Main.init({
        node: document.getElementById('elm-app')
      });
    </script>
  </body>
</html>
