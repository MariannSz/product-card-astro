{
  "name": "product-card-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "elm": "chokidar 'src/**/*.elm' -c 'elm make src/Main.elm --output=public/main.js'",
    "start": "concurrently \"npm run elm\" \"npm run dev\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.15",
    "astro": "^5.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15"
  }
}
